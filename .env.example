# PostgreSQL (System Design §7) — single instance, tenant_id on every table.
# Also the connection pg-boss (job queue) shares — no separate queue infra for v1.
DATABASE_URL="postgresql://user:password@localhost:5432/client_lifecycle_platform"

# AI Gateway (System Design §5) — only src/lib/ai-gateway/adapters/anthropic.ts reads this.
ANTHROPIC_API_KEY=""

# Razorpay (System Design §7) — payments, GST invoices.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp Business API — direct Meta Cloud API (decided over BSP, see PROGRESS.md iteration 17).
WHATSAPP_PROVIDER_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Webhook (src/app/api/webhooks/whatsapp/route.ts) — delivery receipts and
# inbound replies, not needed for outbound sends. WHATSAPP_WEBHOOK_VERIFY_TOKEN
# is any string you choose, entered in Meta's dashboard when registering the
# webhook URL. WHATSAPP_APP_SECRET is from Meta App Dashboard -> Settings ->
# Basic -> App Secret (different from WHATSAPP_PROVIDER_API_KEY above).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Absolute base URL for client-facing links — required for both WhatsApp and
# email (neither has a "current page" to resolve a relative path against the
# way a browser does).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email provider (Resend/SendGrid — System Design §7).
EMAIL_PROVIDER_API_KEY=""

# S3-compatible object storage (System Design §7) — signed PDFs, uploads, handover deliverables.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="ap-south-1"

# SMS/OTP provider — proposal e-sign and auth (System Design §4).
OTP_SMS_PROVIDER_API_KEY=""

NODE_ENV="development"
